{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trackradar",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": [
      "0 2 * * *",
      "0 1 * * 1"
    ]
  },
  // Browser Run（原 Browser Rendering）。对话工具 fetch_page_markdown 走绑定上的
  // quickAction("markdown")，不保存 API Token。部署后使用本账号的 Browser Run。
  // quickAction 在本地模拟里没有实现。要在 `npm run dev` 里实测，先 `npx wrangler login`，
  // 再把下面的 remote 设为 true（只影响本地，会连真实浏览器并消耗 Free 计划额度）。
  // 不要默认打开 remote：未登录时 `npm run dev` 会停在 OAuth，日常本地开发起不来。
  "browser": {
    "binding": "BROWSER"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trackradar",
      "database_id": "6182ca4e-c99a-4199-950c-182196af05b6",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  }
}
